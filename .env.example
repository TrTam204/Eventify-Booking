# ============================================================
#  Salon / Service Booking Platform — Environment Variables
#  Copy this file to .env and fill in your values.
#    cp .env.example .env
# ============================================================

# ── Supabase (required for live data) ───────────────────────
# Create a project at https://supabase.com and copy these from
# Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key (server-side only — Netlify functions)
# Settings → API → service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── App ─────────────────────────────────────────────────────
VITE_APP_URL=https://your-domain.com
VITE_ADMIN_EMAIL=admin@your-domain.com

# ── Business contact (shown in footer / WhatsApp button) ────
VITE_CONTACT_EMAIL=hello@your-domain.com
VITE_CONTACT_PHONE=+1234567890
# WhatsApp number — digits only with country code, no + sign
VITE_WHATSAPP_NUMBER=1234567890
VITE_INSTAGRAM_HANDLE=your-instagram-handle
VITE_FACEBOOK_HANDLE=your-facebook-handle

# ── Email — Resend (https://resend.com) ─────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in your Resend account
RESEND_FROM_EMAIL=noreply@your-domain.com

# ── WhatsApp notifications — Twilio ─────────────────────────
# https://console.twilio.com → Account SID / Auth Token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# WhatsApp-enabled Twilio number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Admin WhatsApp number for inbound booking notifications
APP_ADMIN_WHATSAPP=whatsapp:+1234567890

# ── Email branding (Netlify functions) ──────────────────────
BUSINESS_NAME=YourBusiness
